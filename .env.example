NVIDIA_API_KEY=sua_chave_nvidia_nim
GROQ_API_KEY=sua_chave_groq
ACTA_GROQ_PRIMARY_MODEL=openai/gpt-oss-20b
ACTA_GROQ_FAST_MODEL=openai/gpt-oss-20b
ACTA_GROQ_TIMEOUT_SECONDS=8
ACTA_GROQ_MAX_RETRIES=0
ACTA_GROQ_REASONING_EFFORT=low
ACTA_LLM_PRIMARY_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
ACTA_LLM_PRIMARY_FALLBACK_MODEL=deepseek-ai/deepseek-v4-flash-0731
ACTA_LLM_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
ACTA_LLM_FAST_FALLBACK_MODEL=deepseek-ai/deepseek-v4-flash-0731
ACTA_LLM_PRIMARY_MAX_TOKENS=768
ACTA_LLM_FAST_MAX_TOKENS=384
ACTA_LLM_FAST_REASONING_BUDGET=0
ACTA_SPECIALIST_FEW_SHOTS=false
ACTA_ROUTER_LLM_ALWAYS=false
ACTA_ORCHESTRATOR_LLM=false
ACTA_JUDGE_LLM=false
ACTA_ENFORCE_SPECIALIST_TOOL=true
ACTA_GUARDRAIL_LLM_OUTPUT=false

# O acta-ai não acessa bancos diretamente; memória e dados ficam no MCP.
ACTA_OBSERVABILITY_ENABLED=false
ACTA_OBSERVABILITY_IN_TESTS=false
OTEL_SERVICE_NAME=acta-ai
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=acta
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://api.honeycomb.io/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://api.honeycomb.io/v1/metrics
OTEL_EXPORTER_OTLP_TRACES_HEADERS=x-honeycomb-team=sua_honeycomb_api_key
OTEL_EXPORTER_OTLP_METRICS_HEADERS=x-honeycomb-team=sua_honeycomb_api_key,x-honeycomb-dataset=acta_metrics

ACTA_MCP_URL=http://127.0.0.1:8000/mcp
ACTA_MCP_API_KEY=mesmo_segredo_configurado_no_servidor_mcp
ACTA_MCP_USUARIO_ID=1
ACTA_MCP_EMPRESA_ID=1
ACTA_MCP_TIMEOUT_SECONDS=30
ACTA_MCP_MAX_ATTEMPTS=2
ACTA_A2A_API_KEY=troque-esta-chave
