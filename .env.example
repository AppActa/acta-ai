OPENAI_API_KEY=cole_a_chave_aqui
JEV_API_KEY=apikey_.....

ACTA_OPENAI_MODEL=gpt-6-luna
ACTA_OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
ACTA_OPENAI_REASONING_EFFORT=none
ACTA_OPENAI_MAX_TOKENS=2048

ACTA_MCP_URL=http://127.0.0.1:8000/mcp
ACTA_MCP_API_KEY=pibble
ACTA_MCP_TIMEOUT_SECONDS=20
ACTA_MCP_MAX_ATTEMPTS=2
ACTA_MCP_USUARIO_ID=0
ACTA_MCP_EMPRESA_ID=0

MONGODB_URI=mongo_uri
ACTA_SYSTEM_FEATURES_DB_NAME=acta
ACTA_MEMORY_RECENT_MESSAGES=30
ACTA_MEMORY_SUMMARY_EVERY_MESSAGES=12

GEMINI_API_KEY=gemini_api_key
QDRANT_CLUSTER_ENDPOINT=https://......qdrant.io
QDRANT_API_KEY=qdrant_api_key
QDRANT_MEMORY_MESSAGES_COLLECTION_NAME=memoria_mensagens
QDRANT_MEMORY_VECTOR_SIZE=768
QDRANT_TIMEOUT_SECONDS=10

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lgs
LANGSMITH_PROJECT=acta-ai
